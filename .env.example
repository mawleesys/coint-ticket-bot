# ====================================
# COINT Ticket Bot - Configuration
# ====================================
# ВАЖНО: Это публичный репозиторий!
# Никогда не коммитьте реальные токены, IP, email или данные игроков.
# Копируйте этот файл в .env и заполните реальными значениями локально.

# --- Основные настройки ---

# Режим "сухого прогона" — бот стартует без Discord/site токенов
# и только логирует, что сделал бы (true/false)
DRY_RUN=false

# Через сколько мс завершить процесс в dry-run (0 = работать дальше).
# Удобно для CI: DRY_RUN_EXIT_AFTER_MS=4000
DRY_RUN_EXIT_AFTER_MS=0

# Уровень логирования: trace, debug, info, warn, error, fatal, silent
LOG_LEVEL=info

# Порт для healthcheck endpoint (по умолчанию 3000)
HEALTH_PORT=3000

# --- Discord ---

# Токен Discord бота (получите на https://discord.com/developers/applications)
# Необходимые intents: Guilds, GuildMessages, MessageContent, GuildMembers
DISCORD_TOKEN=

# ID сервера Discord (правый клик на сервер → Копировать ID, требуется Режим разработчика)
DISCORD_GUILD_ID=

# ID канала-форума для тикетов (правый клик на канал → Копировать ID)
# Тип канала должен быть Forum Channel
DISCORD_FORUM_CHANNEL_ID=

# ID канала-форума для конфиденциальных тикетов (жалобы на администрацию)
# Доступ только для старшей администрации
DISCORD_CONFIDENTIAL_FORUM_CHANNEL_ID=

# ID роли, с которой начинается staff (например, "Хелпер")
# Используется только для информационных целей; реальные права проверяются через сайт
DISCORD_MIN_STAFF_ROLE_ID=

# --- Сайт (Azuriom) ---

# Базовый URL сайта (без слеша на конце)
# Пример: https://example.com
SITE_URL=

# Токен для Internal Ticket API (задается на сайте через SUPPORT_INTERNAL_TOKEN)
# Должен совпадать со значением в .env сайта
SITE_API_TOKEN=

# Таймаут запросов к API сайта (в миллисекундах)
SITE_API_TIMEOUT=10000

# --- Синхронизация ---

# Интервал опроса GET /events (секунды)
SYNC_POLL_INTERVAL=30

# Максимальное количество тикетов для обработки за один цикл (legacy)
SYNC_BATCH_SIZE=50

# Сколько событий запрашивать из outbox за раз (1–500)
SYNC_EVENTS_LIMIT=100

# Файл курсора after_id (не коммитить; см. .gitignore data/)
SYNC_CURSOR_PATH=./data/event-cursor.json

# --- Статистика ---

# Включить сбор статистики (true/false)
STATS_ENABLED=true

# День недели для еженедельного отчета (0=воскресенье, 1=понедельник, ..., 6=суббота)
STATS_WEEKLY_REPORT_DAY=1

# Час для еженедельного отчета (0-23, по UTC)
STATS_WEEKLY_REPORT_HOUR=9

# ID канала для публикации статистики
DISCORD_STATS_CHANNEL_ID=

# --- Дополнительно ---

# Максимальный размер вложений для пересылки (в байтах)
# По умолчанию 8MB (лимит сайта)
MAX_ATTACHMENT_SIZE=8388608

# Включить дебаг-вывод для запросов к API (true/false)
DEBUG_API_REQUESTS=false

# --- Feature flags (реальные endpoint'ы сайта, по умолчанию включены) ---
# Поставьте false только если нужен временный откат.

FEATURE_SITE_EVENT_FEED=true
FEATURE_DISCORD_USER_LOOKUP=true
FEATURE_SITE_PERMISSION_CHECK=true
FEATURE_MESSAGE_DEDUPE_BY_EXTERNAL_ID=true
FEATURE_CATEGORIES_ENDPOINT=true
